#!/usr/bin/env bash

# Copyright (C) 2025 One More Game - All Rights Reserved
# Unauthorized copying of this file, via any medium is strictly prohibited
# Proprietary and confidential

set -euo pipefail

S3_BUCKET="steambbeditor.onemoregame.com"

echo "Syncing dist/ to s3://${S3_BUCKET}..."
aws s3 sync dist/ "s3://${S3_BUCKET}" --delete

echo "Invalidating CloudFront cache..."
# Get distribution ID from terraform output or environment
DISTRIBUTION_ID="${CLOUDFRONT_DISTRIBUTION_ID:-$(cd terraform/environments/live && terraform output -raw cloudfront_distribution_id)}"
aws cloudfront create-invalidation --distribution-id "${DISTRIBUTION_ID}" --paths "/*"

echo "Published to https://${S3_BUCKET}"
