resource "github_repository" "this" {
  name                   = "steam-bbcode"
  delete_branch_on_merge = true
  description            = "Markdown to Steam BBCode editor with live preview"
  has_issues             = false
  has_projects           = false
  has_wiki               = false
  visibility             = "private"

  lifecycle {
    prevent_destroy = true
  }
}

resource "github_branch_default" "this" {
  repository  = github_repository.this.name
  branch      = "main"
}

resource "github_team_repository" "bots" {
  team_id    = data.terraform_remote_state.github.outputs.bots_team.id
  repository = github_repository.this.name
  permission = "push"
}

resource "github_team_repository" "dev" {
  team_id    = data.terraform_remote_state.github.outputs.dev_team.id
  repository = github_repository.this.name
  permission = "push"
}

