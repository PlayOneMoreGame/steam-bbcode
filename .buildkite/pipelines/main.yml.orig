#omgcmd { overwrite: false }

#########################################################################
#
#                 -- SteamBBEditor Build Pipeline --
#
#########################################################################

steps:
  #
  # Test
  #
  - label: ":npm: Test"
    command:
      - npm ci
      - npm run test:run
    agents:
      os: linux
      hardware_env: dev
    artifact_paths:
      - "logs/*"

  - wait

  #
  # Build Web App
  #
  - label: ":web: Build Web"
    command:
      - npm ci
      - npm run build
      - tar -czf dist.tar.gz dist/
    agents:
      os: linux
      hardware_env: dev
    artifact_paths:
      - "dist.tar.gz"

  #
  # Build Desktop Apps
  #
  - label: ":windows: Build Windows"
    command:
      - npm ci
      - npm run tauri:build
    agents:
      os: win64
      hardware_env: dev
    artifact_paths:
      - "src-tauri/target/release/bundle/msi/*.msi"

  - label: ":mac: Build macOS ARM"
    command:
      - npm ci
      - npm run tauri:build -- --target aarch64-apple-darwin
    agents:
      os: macos
      hardware_env: dev
    artifact_paths:
      - "src-tauri/target/aarch64-apple-darwin/release/bundle/dmg/*.dmg"

  - label: ":mac: Build macOS Intel"
    command:
      - npm ci
      - npm run tauri:build -- --target x86_64-apple-darwin
    agents:
      os: macos
      hardware_env: dev
    artifact_paths:
      - "src-tauri/target/x86_64-apple-darwin/release/bundle/dmg/*.dmg"
