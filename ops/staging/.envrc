# shellcheck disable=SC2059
# shellcheck disable=SC1090
# shellcheck disable=SC1091

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(realpath "$SCRIPT_DIR/../..")"

readonly ENV="staging"
readonly INFRA_ENV="dev"

export OMG_ENV="unset"

source_up

source "$WORKSPACE/bin/lib"

# Configure AWS profile for tools that use the Go AWS SDK directly
# (e.g., ACME provider's lego Route 53 DNS challenge).
# On build servers, assume role uses IMDS — skip profile config.
if [[ -z "${TF_VAR_use_assume_role:-}" ]]; then
  export AWS_PROFILE="$INFRA_ENV"
  export AWS_SDK_LOAD_CONFIG=true
fi

if "$WORKSPACE/bin/login" "$ENV" "$INFRA_ENV"; then
  export OMG_ENV=$ENV
else
  printf "\n\n${RED}Environment $ENV setup failed${NC}\n\n\n"
  exit 1
fi
