{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "© 2026 One More Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "Convert Markdown to Steam BBCode with live preview, linting, and Discord export.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "description": "Markdown files"
      },
      {
        "ext": ["txt"],
        "mimeType": "text/plain",
        "description": "Text files"
      },
      {
        "ext": ["bbcode"],
        "mimeType": "text/plain",
        "description": "BBCode files"
      }
    ],
    "resources": [],
    "shortDescription": "Markdown to Steam BBCode converter",
    "targets": "all"
  },
  "productName": "SteamBBEditor",
  "mainBinaryName": "SteamBBEditor",
  "version": "1.7.0",
  "identifier": "com.onemoregame.steam-bbcode",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/PlayOneMoreGame/steam-bbcode/releases/latest/download/latest.json"
      ],
      "pubkey": "UPDATER_PUBKEY_PLACEHOLDER"
    }
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "width": 1200,
        "minHeight": 600,
        "minWidth": 800,
        "resizable": true,
        "title": "SteamBBEditor",
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src ipc: http://ipc.localhost 'self' https://api.anthropic.com; font-src 'self'"
    }
  }
}